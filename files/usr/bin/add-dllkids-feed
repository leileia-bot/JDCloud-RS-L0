#!/bin/sh
# 可选：加 kenzok8 插件源（mihomo/sing-box/passwall/daed/alist…）
# 该源 640 个包中 kmod 为 0，不会碰内核；只需注意 luci-lib-* 版本。
# 不用时：把 customfeeds.list 里 down.dllkids 那行删掉即可。
set -eu
U=https://down.dllkids.xyz/openwrt-feed
BR=25.12

ARCH=$(sed -n "s/^DISTRIB_ARCH=['\"]\([^'\"]*\)['\"].*/\1/p" /etc/openwrt_release 2>/dev/null | head -n1)
[ -n "$ARCH" ] || ARCH=$(apk --print-arch)
[ -n "$ARCH" ] || { echo "无法识别架构"; exit 1; }

echo "架构: $ARCH"
mkdir -p /etc/apk/keys
if ! wget -q -O /etc/apk/keys/dllkids-feed.pub.pem "$U/keys/dllkids-feed.pub.pem"; then
	echo "公钥下载失败"; exit 1
fi
echo "公钥已装: /etc/apk/keys/dllkids-feed.pub.pem"

D=/etc/apk/repositories.d
mkdir -p "$D"
F="$D/customfeeds.list"
touch "$F"
if grep -q 'down\.dllkids\.xyz' "$F"; then
	echo "源已存在，跳过写入"
else
	echo "$U/$BR/$ARCH" >> "$F"
	echo "已写入: $U/$BR/$ARCH"
fi

echo "== apk update =="
apk update || true
echo
echo "装包前先预演：apk add --dry-run <包名>，看第二段有没有 luci-base / luci-lib-*"
